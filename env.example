# =============================================================================
# NPanel 前端（admin / user / payment-portal 三端共用）环境变量
#
# 使用方法
#   1. 复制本文件为 .env，放在仓库根目录（与 package.json 同级）
#        cp env.example .env
#   2. 按下面注释修改需要的变量
#   3. 在仓库根目录执行：bun install && bun run build
#      产物分别在 apps/admin/dist、apps/user/dist、apps/payment-portal/dist
#
# 重要说明
#   - 这些变量不是服务器环境变量。Vite 会在构建时把它们内联进 JS 文件，
#     所以改完必须重新构建才会生效。
#   - 三端共用这一份配置，目录不再有独立的 .env。
#   - 唯一例外是 VITE_API_BASE_URL：构建产物里的 dist/env.js 也保存了它，
#     部署后直接改 dist/env.js 并刷新浏览器即可生效，不用重新构建。
# =============================================================================


# -----------------------------------------------------------------------------
# 后端 API 地址（必填）
# 需要带协议，不要以 / 结尾。
# 留空 = 请求当前站点自身（同源），此时需要 Web 服务器把 /v1 反代到后端。
# 常见写法：https://api.your-domain.com
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.your-domain.com


# -----------------------------------------------------------------------------
# API 路径前缀（可选，默认空）
# 只有后端挂在子路径下时才需要，例如网关把接口暴露在 /panel 下，就填 /panel。
# 注意：该变量在构建时写死，部署后改 dist/env.js 不会影响它。
# -----------------------------------------------------------------------------
VITE_API_PREFIX=


# -----------------------------------------------------------------------------
# 静态资源 CDN 前缀（可选，默认 https://cdn.jsdmirror.com）
# 只在 admin / user 端用于加速图标等静态资源；留空表示不使用 CDN。
# -----------------------------------------------------------------------------
VITE_CDN_URL=https://cdn.jsdmirror.com


# -----------------------------------------------------------------------------
# 是否显示使用教程文档入口（可选，true / false）
# 只在 admin / user 端生效。
# -----------------------------------------------------------------------------
VITE_TUTORIAL_DOCUMENT=true


# -----------------------------------------------------------------------------
# 用户端首页是否展示落地页（可选，true / false，默认 true）
# 设为 false 时，访问首页会直接跳到登录页。
# 只在 user 端生效。
# -----------------------------------------------------------------------------
VITE_SHOW_LANDING_PAGE=true


# -----------------------------------------------------------------------------
# 登录页预填的账号密码（仅开发调试用，生产环境请留空）
# 只在 admin / user 端生效。
# -----------------------------------------------------------------------------
VITE_USER_EMAIL=
VITE_USER_PASSWORD=


# -----------------------------------------------------------------------------
# 支付门户：充值预设金额（可选，英文逗号分隔，单位：元）
# 不填则使用内置默认值 10,20,50,100。
# 只在 payment-portal 端生效。
# -----------------------------------------------------------------------------
VITE_PAYMENT_PORTAL_AMOUNTS=200,300,500,800


# -----------------------------------------------------------------------------
# 支付门户：自定义金额的最小值（可选，单位：元，默认 1）
# 只在 payment-portal 端生效。
# -----------------------------------------------------------------------------
VITE_PAYMENT_PORTAL_MIN_CUSTOM_AMOUNT=1


# -----------------------------------------------------------------------------
# 支付门户：金额显示的货币代码（可选，ISO 4217，例如 USD / CNY / EUR）
# 留空则沿用浏览器区域默认格式。注意后端实际结算币种由后端配置决定，
# 这里只影响页面上的货币符号展示。
# 只在 payment-portal 端生效。
# -----------------------------------------------------------------------------
VITE_PAYMENT_PORTAL_CURRENCY=


# -----------------------------------------------------------------------------
# 支付门户：公告栏文案（可选，多条之间用英文竖线 | 分隔）
# 只在 payment-portal 端生效。
# -----------------------------------------------------------------------------
VITE_PAYMENT_PORTAL_NEWS=New payment channels can be enabled directly from the existing backend.|Recharge orders keep using the current order and checkout APIs.|Preset recharge amounts and minimum custom amount are controlled by this frontend .env.
